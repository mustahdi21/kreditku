# -----------------------------------------------------------------------------
# KreditKu — contoh konfigurasi lingkungan
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env yang berisi nilai sebenarnya.
# -----------------------------------------------------------------------------
# Semua variabel yang diawali VITE_ akan ter-bundle ke frontend dan BERSIFAT PUBLIK.
# Jangan pernah menaruh service_role key, password database, atau token provider
# apa pun pada variabel VITE_.

# Wajib — URL proyek Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Wajib — anon / publishable key (aman dipublikasikan SELAMA RLS benar)
VITE_SUPABASE_ANON_KEY=

# Opsional — base path aplikasi.
# Gunakan "/" untuk domain sendiri atau Vercel/Netlify.
# Gunakan "/nama-repository/" untuk GitHub Pages pada subpath repository.
VITE_BASE_PATH=/

# Opsional — identitas aplikasi untuk tampilan dan metadata
VITE_APP_NAME=KreditKu
VITE_DEFAULT_CURRENCY=IDR
VITE_DEFAULT_TIMEZONE=Asia/Jakarta
VITE_DEFAULT_LOCALE=id-ID

# -----------------------------------------------------------------------------
# Berikut ini dipakai HANYA oleh proses server/CI (scripts, Edge Functions,
# GitHub Actions). Nilai-nilainya tidak boleh diawali VITE_.
# Simpan pada .env.local (sudah di-.gitignore) atau pada GitHub Secrets.
# -----------------------------------------------------------------------------

# Dipakai oleh scripts/setup.mjs, db-check.mjs, bootstrap-admin.mjs
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Hanya diperlukan oleh skrip server-side (db-check / bootstrap admin).
# Perlakukan sebagai rahasia tingkat tertinggi. Jangan pakai di frontend.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Bootstrap super admin (scripts/bootstrap-admin.mjs)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_NAME=

# Pengingat / notifikasi (dipakai Edge Function, bukan frontend)
WAHASENDER_API_KEY=
WAHASENDER_API_URL=https://api.wahasender.com/api/send-message
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_CRON_SECRET=
